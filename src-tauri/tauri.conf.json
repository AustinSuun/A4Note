{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A4Note",
  "version": "0.1.1",
  "identifier": "app.aster.research",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "A4Note",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"],
    "publisher": "A4Note",
    "category": "Education",
    "shortDescription": "Local-first research assistant for papers, notes, annotations, and AI context.",
    "longDescription": "A4Note is a local-first knowledge workspace that keeps papers, PDFs, translated PDFs, tags, notes, annotations, and AI conversations bound to the same paper record.",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
