{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A4 Note",
  "version": "0.1.9",
  "identifier": "app.aster.research",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "A4 Note",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "resizable": true,
        "maximizable": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "publisher": "A4 Note",
    "category": "Education",
    "shortDescription": "Local-first research assistant for papers, notes, annotations, and AI context.",
    "longDescription": "A4 Note is a local-first knowledge workspace that keeps papers, PDFs, translated PDFs, tags, notes, annotations, and AI conversations bound to the same paper record.",
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "native-host-hooks.nsh",
        "installMode": "currentUser"
      }
    },
    "resources": {
      "resources/native-host/a4note-native-host.exe": "native-host/a4note-native-host.exe",
      "resources/native-host/host-manifest.json": "native-host/app.aster.research.capture.json",
      "../apps/project-tasks/bootstrap.mjs": "project-tasks/bootstrap.mjs",
      "../apps/project-tasks/gateway.mjs": "project-tasks/gateway.mjs",
      "../apps/project-tasks/gateway-bootstrap.mjs": "project-tasks/gateway-bootstrap.mjs",
      "../apps/project-tasks/lib/acceptance-policy.mjs": "project-tasks/lib/acceptance-policy.mjs",
      "../apps/project-tasks/lib/acceptance-store.mjs": "project-tasks/lib/acceptance-store.mjs",
      "../apps/project-tasks/lib/data-dir.mjs": "project-tasks/lib/data-dir.mjs",
      "../apps/project-tasks/lib/acceptance-fixtures-cli.mjs": "project-tasks/lib/acceptance-fixtures-cli.mjs",
      "../apps/project-tasks/lib/acceptance-fixtures.mjs": "project-tasks/lib/acceptance-fixtures.mjs",
      "../apps/project-tasks/lib/project-onboarding.mjs": "project-tasks/lib/project-onboarding.mjs",
      "../apps/project-tasks/server.mjs": "project-tasks/server.mjs",
      "../apps/project-tasks/lib/store.mjs": "project-tasks/lib/store.mjs",
      "../apps/project-tasks/lib/agent-client.mjs": "project-tasks/lib/agent-client.mjs",
      "../apps/project-tasks/cli.mjs": "project-tasks/cli.mjs",
      "../apps/project-tasks/mcp.mjs": "project-tasks/mcp.mjs"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4OEJBRkJCNjA0MUY1RDkKUldUWjlVRmd1NitMdVBoQlB2Y2RtSXhLVThYWXdmU2VmbDVrK1pBUjFDTnl1TFBYalNvQy83QlEK",
      "endpoints": [
        "https://github.com/AustinSuun/A4Note/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
