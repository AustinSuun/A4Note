{
  "manifest_version": 3,
  "name": "A4 Note 论文采集（开发版）",
  "version": "0.5.0",
  "description": "采集论文信息及PDF到A4 Note文献库，保留元数据来源并支持本地PDF补充。",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "采集论文到 A4 Note"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "optional_host_permissions": [
    "https://*/*"
  ],
  "key": ""
}
