{
  "manifest_version": 3,
  "name": "A4 Note · 保存论文",
  "version": "0.6.1",
  "description": "识别当前论文，选择文献库分类，一起保存 PDF、论文信息和来源。",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "采集论文到 A4 Note",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "optional_host_permissions": [
    "https://*/*"
  ],
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
